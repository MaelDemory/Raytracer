size 7680 4320
output scene6.png

# Camera: wide shot looking at origin from above-right
camera 40 35 60 0 5 0 0 1 0 55

ambient 0.06 0.06 0.06
maxdepth 9

# --- Lights ---
# Overhead white key light
point 0 60 0 0.9 0.9 0.9
# Corner colored lights for rich shadow hues
point 45 20 45 0.7 0.1 0.1
point -45 20 45 0.1 0.7 0.1
point 45 20 -45 0.1 0.1 0.7
point -45 20 -45 0.7 0.7 0.1
# Rim light to outline silhouettes
directional -1 -0.2 -0.5 0.3 0.3 0.35

# --- Mirror box base ---
# Floor: high gloss mirror
diffuse 0.15 0.15 0.15
specular 0.9 0.9 0.9
shininess 1200
plane 0 -2 0 0 1 0

# Back wall: mirror
plane 0 0 -80 0 0 1

# Left wall: semi-gloss
specular 0.6 0.6 0.6
shininess 400
plane -80 0 0 1 0 0

# Right wall: matte to vary reflections
diffuse 0.4 0.4 0.4
specular 0.05 0.05 0.05
shininess 10
plane 80 0 0 -1 0 0

# Ceiling: soft white
ambient 0.1 0.1 0.1
diffuse 0.8 0.8 0.8
specular 0 0 0
shininess 0
plane 0 70 0 0 -1 0

# --- Central reflective tower (stack of spheres) ---
