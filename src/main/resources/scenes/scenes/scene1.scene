size 7680 4320
output scene1.png

# Camera: dramatic angle from above-right
camera 50 40 70 0 8 0 0 1 0 45

ambient 0.01 0.01 0.015
maxdepth 12

# --- Multiple Lights for Complex Shadows ---
# Main white overhead light
point 0 80 0 0.3 0.3 0.3
# Colored corner lights creating colorful shadows
point 60 30 60 0.2 0.05 0.05
point -60 30 60 0.05 0.2 0.05
point 60 30 -60 0.05 0.05 0.2
point -60 30 -60 0.2 0.2 0.05
# Additional accent lights
