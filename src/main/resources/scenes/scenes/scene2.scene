size 7680 4320
output scene2.png

# Camera position: x y z, lookAt: x y z, up: x y z, fov
camera 15 15 15 0 0 0 0 1 0 45

ambient 0.05 0.05 0.05

# Trois lumières ponctuelles de couleurs différentes pour des ombres colorées
point 10 10 0 0.8 0.1 0.1
point 0 10 10 0.1 0.8 0.1
point -10 10 -5 0.1 0.1 0.8

# Une lumière directionnelle faible pour déboucher les ombres
directional -1 -1 -1 0.2 0.2 0.2

# Sol blanc
diffuse 0.9 0.9 0.9
specular 0.1 0.1 0.1
shininess 10
plane 0 -1 0 0 1 0

# Sphère centrale très réfléchissante (miroir)
diffuse 0.1 0.1 0.1
specular 0.9 0.9 0.9
shininess 100
sphere 0 2 0 3

# Sphères rouges autour
diffuse 0.8 0.2 0.2
specular 0.4 0.4 0.4
shininess 50
sphere 5 0 0 1
sphere -5 0 0 1
sphere 0 0 5 1
sphere 0 0 -5 1

# Sphères vertes flottantes
diffuse 0.2 0.8 0.2
sphere 3 4 3 0.8
sphere -3 4 3 0.8
sphere 3 4 -3 0.8
sphere -3 4 -3 0.8

# Pyramide bleue en triangles
maxverts 4
vertex 6 0 6
vertex 8 0 6
vertex 7 0 8
vertex 7 3 7

diffuse 0.2 0.2 0.8
specular 0.5 0.5 0.5
shininess 30
tri 0 1 3
tri 1 2 3
tri 2 0 3
tri 0 1 2

maxdepth 5
